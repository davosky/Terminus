<%= form_with model: place, class: "w-full flex flex-col gap-5 rounded-2xl border border-line p-8", data: { turbo_frame: "_top" } do |f| %>
  <% if place.errors.any? %>
    <ul class="rounded-sm border border-danger p-3 text-danger" role="alert">
      <% place.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="flex flex-col gap-1">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, autofocus: true, class: "field" %>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :position %>
    <%= f.number_field :position, required: true, min: 1, step: 1, class: "field" %>
  </div>
  <div class="mt-3 flex flex-col-reverse items-center gap-5 sm:flex-row sm:justify-end">
    <%= render "shared/back_button", label: t("modal.cancel"), path: places_path %>
    <%= f.button class: "btn btn-primary" do %>
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><%= t("modal.save") %>
    <% end %>
  </div>
<% end %>
