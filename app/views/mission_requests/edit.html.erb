<% content_for :title, "Modifica Richiesta Missione - Terminus" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <h2>
        <%= image_tag("mission_requests/mission_requests_edit.svg", class: "img-fluid me-3", alt: "mission_requests_edit") %>
        <span class="text-warning">
          <i>Modifica Richiesta Missione</i>
        </span>
      </h2>
      <hr class="text-warning mt-3 mb-4"/>
      <div class="card <%= @mission_request.locked? ? "border-danger" : "border-0" %>">
        <div class="card-body">
          <% if @mission_request.locked? %>
            <%= render "locked_warning", mission_request: @mission_request, action_label: "modificato" %>
          <% else %>
            <%= render "form", mission_request: @mission_request %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
