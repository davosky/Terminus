<%= form_with model: vehicle do |f| %>
  <% if vehicle.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% vehicle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :producer, class: "form-label" %>
    <%= f.text_field :producer, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :licence_plate, class: "form-label" %>
    <%= f.text_field :licence_plate, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :cost_per_km, class: "form-label" %>
    <%= f.number_field :cost_per_km, step: 0.01, min: 0, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :position, class: "form-label" %>
    <%= f.number_field :position, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annulla", vehicles_path, class: "btn btn-secondary" %>
  </div>
<% end %>
