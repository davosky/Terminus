<nav class="flex items-center gap-8 bg-deep px-5 h-13 text-nav">
  <%= link_to root_path, class: "text-ink", aria: { label: "Terminus" } do %>
    <%= image_tag("navbar/navbar-logo.svg", size: "106x38", alt:"main-logo") %>
  <% end %>
  <%= link_to t("nav.home"), root_path, class: "hover:text-accent" %>
  <details class="relative ml-auto" name="nav-menu">
    <summary class="list-none cursor-pointer p-2 hover:text-accent"><i class="fa-solid fa-gear mr-2"></i><%= t("nav.utility") %></summary>
    <div class="absolute right-0 z-10 mt-2 min-w-55 rounded-lg border border-line bg-deep p-3 flex flex-col gap-3">
      <%= link_to transports_path, class: "hover:text-accent"  do %>
        <i class="fa-solid fa-truck mr-2"></i>
        <%= t("nav.transports") %>
      <% end %>
      <%= link_to vehicles_path, class: "hover:text-accent" do %>
        <i class="fa-solid fa-car mr-2"></i>
        <%= t("nav.vehicles") %>
      <% end %>
      <%= link_to paths_path, class: "hover:text-accent" do %>
        <i class="fa-solid fa-road mr-2"></i>
        <%= t("nav.paths") %>
      <% end %>
      <%= link_to places_path, class: "hover:text-accent" do %>
        <i class="fa-solid fa-city mr-2"></i>
        <%= t("nav.places") %>
      <% end %>
      <%= link_to structures_path, class: "hover:text-accent" do %>
        <i class="fa-solid fa-building mr-2"></i>
        <%= t("nav.structures") %>
      <% end %>
    </div>
  </details>
  <span class="hidden sm:flex items-center gap-2">
    <i class="fa-solid fa-circle-user mr-2"></i>
    <%= current_user.full_name %>
  </span>
  <details class="relative" name="nav-menu">
    <summary class="list-none cursor-pointer p-2 hover:text-accent" aria-label="<%= t("nav.menu") %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="size-5 fill-current" aria-hidden="true"><path d="M1 3h14v1.6H1zM1 7.2h14v1.6H1zM1 11.4h14V13H1z"/></svg>
    </summary>
    <div class="absolute right-0 z-10 mt-2 min-w-55 rounded-lg border border-line bg-deep p-3 flex flex-col gap-3">
      <span class="sm:hidden text-muted"><%= current_user.full_name %></span>
      <% if current_user.admin? %>
        <%= link_to madmin_root_path, class: "hover:text-accent" do %>
          <i class="fa-solid fa-gear mr-2"></i><%= t("nav.admin") %>
        <% end %>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left cursor-pointer hover:text-accent" do %>
        <i class="fa-solid fa-door-open mr-2"></i><%= t("nav.sign_out") %>
      <% end %>
    </div>
  </details>
</nav>
