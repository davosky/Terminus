<%= render layout: "shared/modal", locals: { icon: "transports/transports_destroy.svg", title: t(".title"), back: transports_path } do %>
  <% if @transport.locked? %>
    <%= render "locked" %>
  <% else %>
    <div class="w-full flex flex-col gap-5">
      <p class="alert-box" role="alert">
        <i class="fa-solid fa-triangle-exclamation text-lg" aria-hidden="true"></i><%= t("transports.confirm_destroy.warning", name: @transport.transport_name) %>
      </p>
      <div class="w-full max-w-89 self-center flex justify-between">
        <%= render "shared/back_button", label: t("modal.cancel"), path: transports_path %>
        <%= button_to transport_path(@transport), method: :delete, class: "btn btn-danger", form: { data: { turbo_frame: "_top" } } do %>
          <i class="fa-solid fa-trash" aria-hidden="true"></i><%= t("transports.confirm_destroy.confirm") %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
