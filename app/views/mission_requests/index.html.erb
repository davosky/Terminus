<% content_for :title, "Richieste Missione - Terminus" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2>
          <%= image_tag("mission_requests/mission_requests_index.svg", class: "img-fluid me-3", alt: "mission_requests_index") %>
          <span class="text-primary">
            <i>Le mie Richieste Missione</i>
          </span>
        </h2>
        <%= link_to new_mission_request_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg"></i><i class="bi bi-airplane me-2"></i>Nuova Richiesta Missione
        <% end %>
      </div>
      <hr class="text-primary mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <% if @mission_requests.any? %>
            <div class="list-group">
              <% @mission_requests.each do |mission_request| %>
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <span class="fs-4 fw-bold">
                      <%= mission_request.name %>
                    </span>
                    <span class="ms-3 fs-5 fw-normal">
                      <%= l(mission_request.departure_date, format: :long) if mission_request.departure_date %> &rarr; <%= l(mission_request.return_date, format: :long) if mission_request.return_date %>
                    </span>
                    <span class="ms-3 fs-6 fw-normal text-body-secondary">
                      <%= mission_request.display_reason %>
                    </span>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to mission_request_path(mission_request), class: "btn btn-sm btn-info", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Visualizza il Record Corrente" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_mission_request_path(mission_request), class: "btn btn-sm btn-warning", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Modifica il Record Corrente" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to confirm_destroy_mission_request_path(mission_request), class: "btn btn-sm btn-danger", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Elimina il Record Corrente" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="card-text text-body-secondary mb-0">Non hai ancora nessuna richiesta missione registrata.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
