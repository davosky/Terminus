<% content_for :title, "Ferie da Approvare - Terminus" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from current_user, :holidays %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2>
          <%= image_tag("holidays/holidays_index.svg", class: "img-fluid me-3", alt: "holidays_index") %>
          <span class="text-primary">
            <i>Ferie da Approvare</i>
          </span>
        </h2>
        <%= link_to holidays_path, class: "btn btn-outline-primary" do %>
          <i class="bi bi-calendar3 me-2"></i>Calendario Ferie
        <% end %>
      </div>
      <hr class="text-primary mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <% if @holidays.any? %>
            <div class="list-group">
              <% @holidays.each do |holiday| %>
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <span class="ms-2 fs-6 fw-bold text-primary">
                      <i class="bi bi-calendar-event me-1"></i>
                      <%= l(holiday.start_date, format: :long) %>
                      <span class="fs-6 fw-bold text-info">&rarr;</span>
                      <%= l(holiday.end_date, format: :long) %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic text-primary">
                      <i class="bi bi-file-text text-primary me-1"></i>
                      <%= holiday.display_reason %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic" style="color: #e83e8c;">
                      <i class="bi bi-person text-primary me-1"></i>
                      <%= holiday.user.full_name %>
                    </span>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to holiday_path(holiday), class: "btn btn-sm btn-info", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Visualizza il Dettaglio" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= button_to approve_director_holiday_path(holiday), method: :patch, class: "btn btn-sm btn-success" do %>
                      <i class="bi bi-check-lg"></i> Approva
                    <% end %>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#reject-modal-<%= holiday.id %>">
                      <i class="bi bi-x-lg"></i> Respingi
                    </button>
                  </div>
                </div>

                <div class="modal fade" id="reject-modal-<%= holiday.id %>" tabindex="-1" aria-labelledby="reject-modal-label-<%= holiday.id %>" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <%= form_with url: reject_director_holiday_path(holiday), method: :patch do %>
                        <div class="modal-header">
                          <h5 class="modal-title" id="reject-modal-label-<%= holiday.id %>">Respingi Richiesta Ferie</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                        </div>
                        <div class="modal-body">
                          <label for="rejection_motivation_<%= holiday.id %>" class="form-label"><%= Holiday.human_attribute_name(:rejection_motivation) %></label>
                          <textarea name="rejection_motivation" id="rejection_motivation_<%= holiday.id %>" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                          <button type="submit" class="btn btn-danger">Respingi</button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="card-text text-body-secondary mb-0">Non ci sono richieste ferie da approvare.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
