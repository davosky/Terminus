<%= render layout: "shared/modal", locals: { icon: "vehicles/vehicles_show.svg", title: t(".title"), back: vehicles_path } do %>
  <div class="w-full flex flex-col gap-8 rounded-2xl border border-line p-8">
    <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3">
      <% %i[producer name licence_plate power].each do |attribute| %>
        <dt class="text-muted"><%= Vehicle.human_attribute_name(attribute) %></dt>
        <dd><%= @vehicle.public_send(attribute) %></dd>
      <% end %>
      <dt class="text-muted"><%= Vehicle.human_attribute_name(:cost_per_km) %></dt>
      <dd><%= number_to_currency(@vehicle.cost_per_km) %></dd>
      <dt class="text-muted"><%= Vehicle.human_attribute_name(:position) %></dt>
      <dd><%= @vehicle.position %></dd>
    </dl>
    <div class="flex justify-end">
      <%= render "shared/back_button", label: t("modal.close"), path: vehicles_path %>
    </div>
  </div>
<% end %>
