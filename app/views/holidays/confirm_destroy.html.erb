<% content_for :title, "Elimina Ferie" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <h2 class="text-danger">
        <%= image_tag("holidays/holidays_destroy.svg", class: "img-fluid me-3", alt: "holidays_destroy") %>
        <span class="text-danger">
          <i>Elimina Ferie</i>
        </span>
      </h2>
      <hr class="text-danger mt-3 mb-4"/>
      <div class="card border-danger">
        <div class="card-body">
          <% if @holiday.locked? %>
            <%= render "locked_warning", holiday: @holiday, action_label: "eliminato" %>
          <% else %>
            <h5 class="card-title text-danger">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Conferma eliminazione
            </h5>
            <p class="text-danger mt-3">
              Stai per eliminare le ferie dal&emsp;<strong><%= l(@holiday.start_date, format: :long) %></strong>
              &emsp;al&emsp;<strong><%= l(@holiday.end_date, format: :long) %></strong>
            </p>
            <p class="card-text text-danger">Questa operazione è irreversibile.</p>
            <% if @holiday.requested? %>
              <p class="card-text text-body-secondary">
                <i class="bi bi-envelope me-1"></i>La richiesta è già stata inviata al direttore: riceverà una email di annullamento.
              </p>
            <% end %>
            <div class="d-flex gap-2 mt-4">
              <%= button_to holiday_path(@holiday),
                    method: :delete,
                    class: "btn btn-danger" do %>
                <i class="bi bi-trash"></i>&emsp;Elimina Definitivamente
              <% end %>
              <%= link_to holiday_path(@holiday), class: "btn btn-secondary" do %>
                <i class="bi bi-arrow-counterclockwise"></i>&emsp;Annulla
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
