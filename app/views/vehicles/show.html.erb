<% content_for :title, "#{@vehicle.name} - Terminus" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <h2>
        <%= image_tag("vehicles/vehicles_show.svg", class: "img-fluid me-3", alt: "vehicles_show") %>
        <span class="text-info">
          <i><%= @vehicle.name %></i>
        </span>
      </h2>
      <hr class="text-info mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <dl class="row mb-0 mt-3">
            <dt class="col-sm-3"><%= Vehicle.human_attribute_name(:producer) %></dt>
            <dd class="col-sm-9 fst-italic fw-bold fs-5 text-primary"><%= @vehicle.producer %></dd>
            <dt class="col-sm-3"><%= Vehicle.human_attribute_name(:licence_plate) %></dt>
            <dd class="col-sm-9 fst-italic fw-bold fs-5 text-primary"><%= @vehicle.licence_plate %></dd>
            <dt class="col-sm-3"><%= Vehicle.human_attribute_name(:cost_per_km) %></dt>
            <dd class="col-sm-9 fst-italic fw-bold fs-5 text-primary">&euro;<%= number_with_precision(@vehicle.cost_per_km, precision: 2) %></dd>
            <dt class="col-sm-3"><%= Vehicle.human_attribute_name(:position) %></dt>
            <dd class="col-sm-9 fst-italic fw-bold fs-5 text-primary"><%= @vehicle.position %></dd>
          </dl>
          <div class="d-flex gap-2 mt-3">
            <%= link_to edit_vehicle_path(@vehicle), class: "btn btn-primary" do %>
              <i class="bi bi-pencil"></i>&emsp;Modifica
            <% end %>
            <%= link_to vehicles_path, class: "btn btn-secondary" do %>
              <i class="bi bi-arrow-counterclockwise"></i>&emsp;Torna all'elenco
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
