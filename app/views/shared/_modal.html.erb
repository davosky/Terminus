<%# Modal filling the screen below the navbar (h-13). Usage: render layout: "shared/modal", locals: { icon:, title:, back: } do ... end %>
<% provide :modal_open, true %>
<%= turbo_frame_tag "modal" do %>
  <dialog class="fixed inset-x-0 top-13 bottom-0 z-30 m-0 w-full h-[calc(100dvh-3.25rem)] max-w-none max-h-none backdrop:bg-transparent overflow-auto bg-base px-5 py-8 text-ink"
          aria-labelledby="modal-title" data-controller="modal" data-modal-back-value="<%= back %>" data-action="close->modal#closed">
    <%# Same width and padding as the index pages (main + max-w-233) %>
    <div class="w-full max-w-233 mx-auto flex flex-col gap-8">
      <header class="flex items-center gap-5 border-b border-line pb-5">
        <%= image_tag icon, size: "55x55", alt: "" %>
        <h1 id="modal-title" class="text-lg"><%= title %></h1>
      </header>
      <%= yield %>
    </div>
  </dialog>
<% end %>
