<%= image_tag("main-logo.svg", size: "640x395", alt:"main-logo") %>
<%= form_for(resource, as: resource_name, url: session_path(resource_name),
      html: { class: "w-full max-w-162 flex flex-col gap-5 rounded-2xl border border-line p-8 sm:min-h-100 sm:justify-center" }) do |f| %>
  <div class="flex flex-col gap-1">
    <%= f.label :username %>
    <div class="flex h-13 overflow-hidden rounded-sm bg-field focus-within:outline-2 focus-within:outline-accent">
      <span class="flex h-full aspect-[1.618] items-center justify-center bg-deep">
        <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
      </span>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", autocapitalize: "none", required: true, class: "min-w-0 flex-1 bg-transparent px-3 outline-none" %>
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :password %>
    <div class="flex h-13 overflow-hidden rounded-sm bg-field focus-within:outline-2 focus-within:outline-accent">
      <span class="flex h-full aspect-[1.618] items-center justify-center bg-deep">
        <i class="fa-solid fa-key" aria-hidden="true"></i>
      </span>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "min-w-0 flex-1 bg-transparent px-3 outline-none" %>
    </div>
  </div>
  <%= f.button class: "btn btn-primary mt-3 self-center" do %>
    <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
    <%= t("devise.sessions.new.sign_in") %>
  <% end %>
<% end %>
