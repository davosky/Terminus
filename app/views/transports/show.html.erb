<%= render layout: "shared/modal", locals: { icon: "transports/transports_show.svg", title: t(".title"), back: transports_path } do %>
  <div class="w-full flex flex-col gap-8 rounded-2xl border border-line p-8">
    <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3">
      <dt class="text-muted"><%= Transport.human_attribute_name(:transport_name) %></dt>
      <dd><%= @transport.transport_name %></dd>
      <dt class="text-muted"><%= Transport.human_attribute_name(:transport_position) %></dt>
      <dd><%= @transport.transport_position %></dd>
    </dl>
    <div class="flex justify-end">
      <%= render "shared/back_button", label: t("modal.close"), path: transports_path %>
    </div>
  </div>
<% end %>
