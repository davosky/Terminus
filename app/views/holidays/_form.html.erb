<%= form_with model: holiday do |f| %>
  <% if holiday.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% holiday.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% if holiday.new_record? && current_user.manager? %>
    <div class="mb-3">
      <%= f.label :user_id, Holiday.human_attribute_name(:user), class: form_label_class %>
      <%= f.collection_select :user_id, assignable_users, :id, :full_name, {}, class: "form-select" %>
    </div>
  <% end %>
  <div class="mb-3">
    <%= f.label :start_date, class: form_label_class %>
    <%= f.date_field :start_date, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :end_date, class: form_label_class %>
    <%= f.date_field :end_date, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :reason, class: form_label_class %>
    <%= f.text_field :reason, class: "form-control" %>
  </div>
  <% if holiday.new_record? && current_user.requires_holiday_approval? %>
    <p class="form-text mb-3">
      <i class="bi bi-info-circle me-1"></i>La richiesta verrà inviata al direttore: comparirà nel calendario dopo l'approvazione.
    </p>
  <% end %>
  <div class="d-flex gap-2">
    <%= f.button class: form_submit_accent do %>
      <i class="bi bi-sun me-2"></i><%= form_submit_label(holiday) %>
    <% end %>
    <%= link_to holidays_path, class: "btn btn-secondary" do %>
      <i class="bi bi-arrow-counterclockwise"></i>
      &emsp;
      Annulla
    <% end %>
  </div>
<% end %>
