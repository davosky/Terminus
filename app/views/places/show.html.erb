<%= render layout: "shared/modal", locals: { icon: "places/places_show.svg", title: t(".title"), back: places_path } do %>
  <div class="w-full flex flex-col gap-8 rounded-2xl border border-line p-8">
    <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3">
      <dt class="text-muted"><%= Place.human_attribute_name(:name) %></dt>
      <dd><%= @place.name %></dd>
      <dt class="text-muted"><%= Place.human_attribute_name(:position) %></dt>
      <dd><%= @place.position %></dd>
    </dl>
    <div class="flex justify-end">
      <%= render "shared/back_button", label: t("modal.close"), path: places_path %>
    </div>
  </div>
<% end %>
