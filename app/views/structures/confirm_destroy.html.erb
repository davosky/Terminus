<%= render layout: "shared/modal", locals: { icon: "structures/structures_destroy.svg", title: t(".title"), back: structures_path } do %>
  <div class="w-full flex flex-col gap-5">
    <p class="alert-box" role="alert">
      <i class="fa-solid fa-triangle-exclamation text-lg" aria-hidden="true"></i><%= t("structures.confirm_destroy.warning", name: @structure.name) %>
    </p>
    <div class="w-full max-w-89 self-center flex justify-between">
      <%= render "shared/back_button", label: t("modal.cancel"), path: structures_path %>
      <%= button_to structure_path(@structure), method: :delete, class: "btn btn-danger", form: { data: { turbo_frame: "_top" } } do %>
        <i class="fa-solid fa-trash" aria-hidden="true"></i><%= t("structures.confirm_destroy.confirm") %>
      <% end %>
    </div>
  </div>
<% end %>
