<% content_for :title, "Richieste Ferie - Terminus" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from current_user, :holidays %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2>
          <%= image_tag("holidays/holidays_index.svg", class: "img-fluid me-3", alt: "holidays_index") %>
          <span class="text-primary">
            <i>Le mie Richieste Ferie</i>
          </span>
        </h2>
        <%= link_to new_holiday_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg"></i><i class="bi bi-sun me-2"></i>Richiedi Ferie
        <% end %>
      </div>
      <hr class="text-primary mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <% if @holidays.any? %>
            <div class="list-group">
              <% @holidays.each do |holiday| %>
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 <%= "border-danger" if holiday.rejected? %>">
                  <div>
                    <span class="ms-2 fs-6 fw-bold text-primary">
                      <i class="bi bi-calendar-event me-1"></i>
                      <%= l(holiday.start_date, format: :long) %>
                      <span class="fs-6 fw-bold text-info">&rarr;</span>
                      <%= l(holiday.end_date, format: :long) %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic text-primary">
                      <i class="bi bi-file-text text-primary me-1"></i>
                      <%= holiday.display_reason %>
                    </span>
                    <br/>
                    <span class="ms-2">
                      <% if holiday.rejected? %>
                        <span class="badge text-bg-danger">Respinta</span>
                        <span class="fst-italic ms-1"><%= holiday.rejection_motivation %></span>
                      <% else %>
                        <span class="badge text-bg-secondary">In attesa</span>
                      <% end %>
                    </span>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to holiday_path(holiday), class: "btn btn-sm btn-info", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Visualizza il Record Corrente" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% unless holiday.locked? %>
                      <%= link_to edit_holiday_path(holiday), class: "btn btn-sm btn-warning", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Modifica il Record Corrente" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= link_to confirm_destroy_holiday_path(holiday), class: "btn btn-sm btn-danger", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Elimina il Record Corrente" do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="card-text text-body-secondary mb-0">Non hai richieste ferie in attesa o respinte.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
