<%= form_with model: transport, class: "w-full max-w-162 self-center flex flex-col gap-5", data: { turbo_frame: "_top" } do |f| %>
  <% if transport.errors.any? %>
    <ul class="rounded-sm border border-danger p-3 text-danger" role="alert">
      <% transport.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="flex flex-col gap-1">
    <%= f.label :transport_name do %>
      <i class="fa-solid fa-truck mr-2" aria-hidden="true"></i><%= Transport.human_attribute_name(:transport_name) %>
    <% end %>
    <%= f.text_field :transport_name, required: true, autofocus: true, class: "field" %>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :transport_position do %>
      <i class="fa-solid fa-arrow-down-1-9 mr-2" aria-hidden="true"></i><%= Transport.human_attribute_name(:transport_position) %>
    <% end %>
    <%= f.number_field :transport_position, required: true, min: 1, step: 1, class: "field" %>
  </div>
  <div class="mt-3 flex flex-col-reverse gap-5 sm:flex-row sm:justify-end">
    <%= render "shared/back_button", label: t("modal.cancel"), path: transports_path %>
    <%= f.button class: "btn btn-primary" do %>
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><%= t("modal.save") %>
    <% end %>
  </div>
<% end %>
