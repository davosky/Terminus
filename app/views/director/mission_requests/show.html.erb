<% content_for :title, "#{@mission_request.name} - Terminus" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <h3>
        <%= image_tag("mission_requests/mission_requests_show.svg", class: "img-fluid me-3", alt: "mission_requests_show") %>
        <span class="text-primary">
          <i><%= @mission_request.name %></i>
        </span>
      </h3>
      <hr class="text-info mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <p class="fs-5">
            Richiesta di missione presentata da
            <span class="fw-bold" style="color: #e83e8c;">
              <%= "#{@mission_request.user.first_name} #{@mission_request.user.last_name}" %>
            </span>
            il giorno
            <span class="fw-bold text-primary">
              <%= l(@mission_request.request_date, format: :long) if @mission_request.request_date %>
            </span>.
            <br/>
            Motivo:
            <span class="fw-bold text-primary">
              <%= @mission_request.display_reason %>
            </span>
          </p>
          <p class="fs-6">
            Data partenza <strong><%= l(@mission_request.departure_date, format: :long) if @mission_request.departure_date %></strong>, data di ritorno <strong><%= l(@mission_request.return_date, format: :long) if @mission_request.return_date %></strong>.
            <br/>
            Percorso stimato: <strong><%= @mission_request.display_path %></strong>.
            <br/>
            Luogo della missione <strong><%= @mission_request.display_place %></strong> presso <strong><%= @mission_request.display_structure %></strong>.
            <br/>
            In tutto percorrendo <strong><%= number_with_precision(@mission_request.display_path_lenght, precision: 2) %></strong> km con un costo autostradale pari a <strong><%= number_to_currency(@mission_request.display_highway_cost) %></strong>.
            <br/>
            Trasporto utilizzato <strong><%= @mission_request.transport.name %></strong><% if @mission_request.vehicle %> con il veicolo <strong><%= @mission_request.vehicle.name %></strong><% end %>.
          </p>
          <p class="fs-6">
            <% if @mission_request.pending? %>
              Stato della richiesta: <span class="badge text-bg-secondary">In attesa di approvazione</span>
            <% elsif @mission_request.rejected? %>
              Stato della richiesta: <span class="badge text-bg-danger">Respinta</span>
              <br/>
              Motivo: <%= @mission_request.rejection_motivation %>
            <% else %>
              Stato della richiesta: <span class="badge text-bg-success">Approvata</span>
            <% end %>
          </p>
          <hr class="text-info mt-3 mb-4"/>
          <div class="d-flex gap-2 mt-3 flex-wrap">
            <% if @mission_request.pending? %>
              <%= button_to approve_director_mission_request_path(@mission_request), method: :patch, class: "btn btn-success" do %>
                <i class="bi bi-check-lg"></i>&emsp;Approva
              <% end %>
              <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#reject-modal">
                <i class="bi bi-x-lg"></i>&emsp;Respingi
              </button>
            <% end %>
            <%= link_to director_mission_requests_path, class: "btn btn-secondary" do %>
              <i class="bi bi-arrow-counterclockwise"></i>&emsp;Torna all'elenco
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% if @mission_request.pending? %>
  <div class="modal fade" id="reject-modal" tabindex="-1" aria-labelledby="reject-modal-label" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with url: reject_director_mission_request_path(@mission_request), method: :patch do %>
          <div class="modal-header">
            <h5 class="modal-title" id="reject-modal-label">Respingi Richiesta Missione</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
          </div>
          <div class="modal-body">
            <label for="rejection_motivation" class="form-label"><%= MissionRequest.human_attribute_name(:rejection_motivation) %></label>
            <textarea name="rejection_motivation" id="rejection_motivation" class="form-control" rows="3" required></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
            <button type="submit" class="btn btn-danger">Respingi</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
