<%= image_tag("main-logo.svg", size: "640x395", alt:"main-logo") %>
<%= form_for(resource, as: resource_name, url: session_path(resource_name),
      html: { class: "w-full max-w-162 flex flex-col gap-5 rounded-2xl border border-line p-8 sm:min-h-100 sm:justify-center" }) do |f| %>
  <div class="flex flex-col gap-1">
    <%= f.label :username %>
    <div class="flex h-13 overflow-hidden rounded-sm bg-field focus-within:outline-2 focus-within:outline-accent">
      <span class="flex h-full aspect-[1.618] items-center justify-center bg-deep">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="size-8 fill-current" aria-hidden="true"><path d="M 8,8 A 3,3 0 1 0 8,2 3,3 0 0 0 8,8 m 2,-3 a 2,2 0 1 1 -4,0 2,2 0 0 1 4,0 m 4,8 c 0,1 -1,1 -1,1 H 3 c 0,0 -1,0 -1,-1 0,-1 1,-4 6,-4 5,0 6,3 6,4 M 13,12.996 C 12.999,12.75 12.846,12.01 12.168,11.332 11.516,10.68 10.289,10 8,10 5.711,10 4.484,10.68 3.832,11.332 3.154,12.01 3.002,12.75 3,12.996 Z"/></svg>
      </span>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", autocapitalize: "none", required: true, class: "min-w-0 flex-1 bg-transparent px-3 outline-none" %>
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :password %>
    <div class="flex h-13 overflow-hidden rounded-sm bg-field focus-within:outline-2 focus-within:outline-accent">
      <span class="flex h-full aspect-[1.618] items-center justify-center bg-deep">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="size-8 fill-current" aria-hidden="true"><path d="M 0,8 A 4,4 0 0 1 7.465,6 H 14 a 0.5,0.5 0 0 1 0.354,0.146 l 1.5,1.5 a 0.5,0.5 0 0 1 0,0.708 l -1.5,1.5 a 0.5,0.5 0 0 1 -0.708,0 L 13,9.207 12.354,9.854 a 0.5,0.5 0 0 1 -0.708,0 L 11,9.207 10.354,9.854 a 0.5,0.5 0 0 1 -0.708,0 L 9,9.207 8.354,9.854 A 0.5,0.5 0 0 1 8,10 H 7.465 A 4,4 0 0 1 0,8 M 4,5 A 3,3 0 1 0 6.712,9.285 0.5,0.5 0 0 1 7.163,9 h 0.63 L 8.646,8.146 a 0.5,0.5 0 0 1 0.708,0 L 10,8.793 10.646,8.146 a 0.5,0.5 0 0 1 0.708,0 L 12,8.793 12.646,8.146 a 0.5,0.5 0 0 1 0.708,0 L 14,8.793 14.793,8 l -1,-1 H 7.163 A 0.5,0.5 0 0 1 6.712,6.715 3,3 0 0 0 4,5"/><path d="M 4,8 A 1,1 0 1 1 2,8 1,1 0 0 1 4,8"/></svg>
      </span>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "min-w-0 flex-1 bg-transparent px-3 outline-none" %>
    </div>
  </div>
  <%= f.submit t("devise.sessions.new.sign_in"), class: "mt-3 h-13 rounded-sm bg-accent text-deep cursor-pointer hover:brightness-110" %>
<% end %>
