<% content_for :title, "Rimborsi Spese - Terminus" %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col col-lg-8 p-2 m-2">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2>
          <%= image_tag("reimbursements/reimbursements_index.svg", class: "img-fluid me-3", alt: "reimbursements_index") %>
          <span class="text-primary">
            <i>Rimborsi Spese</i>
          </span>
        </h2>
        <%= link_to new_reimbursement_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg"></i><i class="bi bi-cash-coin me-2"></i>Nuovo Rimborso
        <% end %>
      </div>
      <hr class="text-primary mt-3 mb-4"/>
      <div class="card border-0">
        <div class="card-body">
          <% if @reimbursements.any? %>
            <div class="list-group">
              <% @reimbursements.each do |reimbursement| %>
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <span class="ms-2 fs-6 fw-bold text-primary">
                      <i class="bi bi-calendar-event me-1"></i>
                      <%= l(reimbursement.departure_date, format: :long) if reimbursement.departure_date %>
                      <span class="fs-6 fw-bold text-info">
                        &rarr;
                      </span>
                      <%= l(reimbursement.return_date, format: :long) if reimbursement.return_date %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic text-primary">
                      <i class="bi bi-geo-alt text-primary me-1"></i>
                      <%= reimbursement.display_place %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic text-primary">
                      <i class="bi bi-file-text text-primary me-1"></i>
                      <%= reimbursement.display_reason %>
                    </span>
                    <br/>
                    <span class="ms-2 fs-6 fst-italic" style="color: #e83e8c;">
                      <i class="bi bi-person text-primary me-1"></i>
                      <%= "#{reimbursement.user.first_name} #{reimbursement.user.last_name}" %>
                    </span>
                  </div>
                  <div class="d-flex gap-2">
                    <%= link_to reimbursement_path(reimbursement), class: "btn btn-sm btn-info", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Visualizza il Record Corrente" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_reimbursement_path(reimbursement), class: "btn btn-sm btn-warning", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Modifica il Record Corrente" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to confirm_destroy_reimbursement_path(reimbursement), class: "btn btn-sm btn-danger", data: { bs_toggle: "tooltip", bs_placement: "bottom" }, title: "Elimina il Record Corrente" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="card-text text-body-secondary mb-0">Non hai ancora nessun rimborso spese registrato.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
