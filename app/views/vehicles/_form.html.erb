<%= form_with model: vehicle do |f| %>
  <% if vehicle.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% vehicle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, class: form_label_class_vehicle %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :producer, class: form_label_class_vehicle %>
    <%= f.text_field :producer, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :licence_plate, class: form_label_class_vehicle %>
    <%= f.text_field :licence_plate, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :cost_per_km, class: form_label_class_vehicle %>
    <%= f.number_field :cost_per_km, step: 0.01, min: 0, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :position, class: form_label_class_vehicle %>
    <%= f.number_field :position, class: "form-control" %>
  </div>
  <div class="d-flex gap-2">
    <%= f.button class: form_submit_accent_vehicle do %>
      <i class="bi bi-car-front me-2"></i><%= form_submit_label_vehicle %>
    <% end %>
    <%= link_to vehicles_path, class: "btn btn-secondary" do %>
      <i class="bi bi-arrow-counterclockwise"></i>
      &emsp;
      Annulla
    <% end %>
  </div>
<% end %>
