<%= render "shared/flash" %>
<section class="w-full max-w-233 mb-auto flex flex-col gap-8">
  <header class="flex items-center gap-5 border-b border-line pb-5">
    <%= image_tag "transports/transports_index.svg", size: "55x55", alt: "" %>
    <h1 class="text-lg"><%= t(".title") %></h1>
    <%= link_to new_transport_path, class: "btn btn-primary ml-auto", data: { turbo_frame: "modal" } do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i><span class="hidden sm:inline"><%= t(".new") %></span>
    <% end %>
  </header>
  <table class="w-full text-left">
    <thead class="bg-deep">
      <tr>
        <th class="w-34 p-3"><i class="fa-solid fa-arrow-down-1-9 mr-2" aria-hidden="true"></i><%= Transport.human_attribute_name(:transport_position) %></th>
        <th class="p-3"><i class="fa-solid fa-truck mr-2" aria-hidden="true"></i><%= Transport.human_attribute_name(:transport_name) %></th>
        <th class="p-3"><span class="sr-only"><%= t(".actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @transports.each do |transport| %>
        <tr class="border-b border-line">
          <td class="p-3"><%= transport.transport_position %></td>
          <td class="p-3">
            <%= transport.transport_name %>
            <% if transport.locked? %>
              <i class="fa-solid fa-lock ml-2 text-muted" title="<%= t(".locked") %>" aria-label="<%= t(".locked") %>"></i>
            <% end %>
          </td>
          <td class="p-3">
            <div class="flex justify-end gap-5">
              <%= link_to transport_path(transport), class: "hover:text-accent", data: { turbo_frame: "modal" }, aria: { label: t(".show") }, title: t(".show") do %>
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
              <% end %>
              <%= link_to edit_transport_path(transport), class: "hover:text-accent", data: { turbo_frame: "modal" }, aria: { label: t(".edit") }, title: t(".edit") do %>
                <i class="fa-solid fa-pen" aria-hidden="true"></i>
              <% end %>
              <%= link_to confirm_destroy_transport_path(transport), class: "hover:text-danger", data: { turbo_frame: "modal" }, aria: { label: t(".destroy") }, title: t(".destroy") do %>
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @transports.empty? %>
    <p class="text-center text-muted"><%= t(".empty") %></p>
  <% end %>
</section>
