<% content_for :title, "Richieste Missione Dipendenti - Terminus" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from current_user, :mission_requests %>
<%= render "list",
           mission_requests: @mission_requests,
           heading: "Richieste Missione Dipendenti",
           empty_message: "Non ci sono richieste missione dei tuoi dipendenti." %>
